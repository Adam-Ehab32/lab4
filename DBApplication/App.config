<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- "Data Source=." = local default SQL Server instance.
         If you use SQL Server Express, change it to:  Data Source=.\SQLEXPRESS
         If you use SQL Server Authentication, replace Integrated Security=True with:
         User Id=YOUR_USER;Password=YOUR_PASSWORD -->
    <add name="MyConnectionString"
         connectionString="Data Source=.;Initial Catalog=SPJ_DB_Lab4;Integrated Security=True"/>
  </connectionStrings>
</configuration>
